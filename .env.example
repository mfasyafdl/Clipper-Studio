# Salin file ini menjadi .env lalu isi kuncinya.

# --- LLM untuk memilih highlight (wajib salah satu) ---
# Gemini punya kuota gratis; cukup untuk mulai.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Transkripsi (WhisperX) ---
LANGUAGE=id
WHISPER_MODEL=large-v3-turbo
# VRAM 4 GB (mis. RTX 3050 Laptop): WHISPER_BATCH=4 + WHISPER_COMPUTE=int8_float16.
# VRAM 6-8 GB: 8 aman. VRAM 12 GB ke atas: boleh 16.
WHISPER_BATCH=8
WHISPER_COMPUTE=float16
DEVICE=cuda

# --- Gaya subtitle ---
CAPTION_FONT=Arial Black
CAPTION_SIZE=84
CAPTION_WORDS=3
CAPTION_UPPERCASE=1
HOOK_SECONDS=3
HOOK_SIZE=62

# --- Folder output semua job (video sumber, klip, review) ---
# Boleh ada spasi, tanpa tanda kutip. Kosongkan untuk pakai folder jobs\ di repo.
JOBS_DIR=E:\VIdeo Clipping

# auto = coba NVENC (GPU) dulu, lalu libx264
VIDEO_ENCODER=auto
